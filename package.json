{
  "name": "@ifsoul/core",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "description": "Experimental public IfSoul protocol, runtime, memory and provider primitives",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.18 <25"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:contracts": "node --test tests/contracts/*.test.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:runtime": "tsx --test tests/runtime/*.test.ts",
    "generate:validators": "node scripts/generate-validators.mjs",
    "check:validators": "node scripts/generate-validators.mjs --check",
    "build": "tsc --project tsconfig.build.json && node scripts/copy-build-assets.mjs",
    "pack:core": "pnpm build && pnpm --config.ignore-scripts=true pack --pack-destination .local/packages",
    "typecheck": "tsc --noEmit --project tsconfig.build.json && tsc --noEmit --project tsconfig.json",
    "test:providers": "tsx --test tests/providers/*.test.ts",
    "test:tooling": "node --test tests/tooling/boundaries.test.mjs tests/tooling/core-package.test.mjs",
    "check": "pnpm check:version && pnpm format:check && pnpm typecheck && pnpm check:contracts && pnpm test:runtime && pnpm test:providers && pnpm check:validators && pnpm test:tooling && pnpm check:docs && pnpm check:boundaries && pnpm build",
    "check:version": "node scripts/check-version.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "files": [
    "dist/packages",
    "packages/protocol/schemas",
    "specs",
    "README.md",
    "LICENSE",
    "LICENSES/CC-BY-4.0.txt",
    "LICENSES/CC0-1.0.txt",
    "release.json"
  ],
  "sideEffects": false,
  "exports": {
    "./protocol": {
      "types": "./dist/packages/protocol/src/index.d.ts",
      "import": "./dist/packages/protocol/src/index.js"
    },
    "./runtime": {
      "types": "./dist/packages/runtime/src/index.d.ts",
      "import": "./dist/packages/runtime/src/index.js"
    },
    "./memory/port": {
      "types": "./dist/packages/memory/src/port.d.ts",
      "import": "./dist/packages/memory/src/port.js"
    },
    "./memory/sql": {
      "types": "./dist/packages/memory/src/sql.d.ts",
      "import": "./dist/packages/memory/src/sql.js"
    },
    "./memory/sqlite": {
      "types": "./dist/packages/memory/src/sqlite.d.ts",
      "import": "./dist/packages/memory/src/sqlite.js"
    },
    "./model-providers": {
      "types": "./dist/packages/model-providers/src/index.d.ts",
      "import": "./dist/packages/model-providers/src/index.js"
    },
    "./model-providers/types": {
      "types": "./dist/packages/model-providers/src/types.d.ts",
      "import": "./dist/packages/model-providers/src/types.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openifsoul/core.git"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
