{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "esModuleInterop": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "packages/protocol/src/**/*.ts",
    "packages/runtime/src/**/*.ts",
    "packages/memory/src/**/*.ts",
    "packages/model-providers/src/**/*.ts",
    "tests/runtime/**/*.ts",
    "tests/providers/**/*.ts"
  ]
}
