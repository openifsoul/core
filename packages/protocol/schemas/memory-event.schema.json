{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ifsoul:protocol:draft-0.1.0:memory-event",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "draft-0.1.0"
    },
    "kind": {
      "const": "memory-event"
    },
    "eventId": {
      "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/id"
    },
    "characterId": {
      "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/id"
    },
    "worldId": {
      "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/id"
    },
    "sessionId": {
      "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/id"
    },
    "source": {
      "type": "object",
      "properties": {
        "sourceId": {
          "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/id"
        },
        "kind": {
          "enum": ["world-adapter", "runtime", "user", "import"]
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["sourceId", "kind", "sequence"],
      "additionalProperties": false
    },
    "observerId": {
      "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/id"
    },
    "recordedAt": {
      "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/utcTimestamp"
    },
    "worldTime": {
      "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/worldTime"
    },
    "scope": {
      "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/scope"
    },
    "payload": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/id"
        },
        "data": {
          "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/jsonObject"
        }
      },
      "required": ["type", "data"],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "eventIds": {
          "type": "array",
          "items": {
            "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/id"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "worldEventIds": {
          "type": "array",
          "items": {
            "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/id"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": ["eventIds", "worldEventIds"],
      "additionalProperties": false
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "extensions": {
      "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/extensions"
    },
    "requiredExtensions": {
      "type": "array",
      "items": {
        "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/extensionName"
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "eventId",
    "characterId",
    "worldId",
    "sessionId",
    "source",
    "observerId",
    "recordedAt",
    "worldTime",
    "scope",
    "payload",
    "provenance"
  ],
  "additionalProperties": false
}
