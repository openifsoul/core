{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ifsoul:protocol:0.4.0:character",
  "oneOf": [
    {
      "$ref": "#/$defs/template"
    },
    {
      "$ref": "#/$defs/instance"
    }
  ],
  "$defs": {
    "template": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "0.4.0"
        },
        "kind": {
          "const": "character-template"
        },
        "templateId": {
          "$ref": "urn:ifsoul:protocol:0.4.0:common#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "authorship": {
          "type": "object",
          "properties": {
            "authors": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true
            },
            "license": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": ["authors", "license"],
          "additionalProperties": false
        },
        "extensions": {
          "$ref": "urn:ifsoul:protocol:0.4.0:common#/$defs/extensions"
        },
        "requiredExtensions": {
          "type": "array",
          "items": {
            "$ref": "urn:ifsoul:protocol:0.4.0:common#/$defs/extensionName"
          },
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "templateId",
        "revision",
        "profile",
        "authorship"
      ],
      "additionalProperties": false
    },
    "instance": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "0.4.0"
        },
        "kind": {
          "const": "character-instance"
        },
        "characterId": {
          "$ref": "urn:ifsoul:protocol:0.4.0:common#/$defs/id"
        },
        "participantId": {
          "$ref": "urn:ifsoul:protocol:0.4.0:common#/$defs/id"
        },
        "createdAt": {
          "$ref": "urn:ifsoul:protocol:0.4.0:common#/$defs/utc"
        },
        "template": {
          "type": "object",
          "properties": {
            "templateId": {
              "$ref": "urn:ifsoul:protocol:0.4.0:common#/$defs/id"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": ["templateId", "revision"],
          "additionalProperties": false
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "memoryRecordIds": {
          "type": "array",
          "items": {
            "$ref": "urn:ifsoul:protocol:0.4.0:common#/$defs/id"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "relationshipMemoryIds": {
          "type": "array",
          "items": {
            "$ref": "urn:ifsoul:protocol:0.4.0:common#/$defs/id"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "lineage": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "operation": {
                "enum": ["fork", "import"]
              },
              "sourceCharacterId": {
                "$ref": "urn:ifsoul:protocol:0.4.0:common#/$defs/id"
              },
              "sourceArchiveId": {
                "$ref": "urn:ifsoul:protocol:0.4.0:common#/$defs/id"
              },
              "recordedAt": {
                "$ref": "urn:ifsoul:protocol:0.4.0:common#/$defs/utc"
              }
            },
            "required": [
              "operation",
              "sourceCharacterId",
              "sourceArchiveId",
              "recordedAt"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 64
        },
        "extensions": {
          "$ref": "urn:ifsoul:protocol:0.4.0:common#/$defs/extensions"
        },
        "requiredExtensions": {
          "type": "array",
          "items": {
            "$ref": "urn:ifsoul:protocol:0.4.0:common#/$defs/extensionName"
          },
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "characterId",
        "participantId",
        "createdAt",
        "profile",
        "memoryRecordIds",
        "relationshipMemoryIds"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "traits": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "$ref": "urn:ifsoul:protocol:0.4.0:common#/$defs/id"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          }
        },
        "preferences": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "preferenceId": {
                "$ref": "urn:ifsoul:protocol:0.4.0:common#/$defs/id"
              },
              "subject": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "stance": {
                "enum": ["like", "dislike", "avoid", "seek"]
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "strength": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": ["preferenceId", "subject", "stance", "description"],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 32
        },
        "speechStyle": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "languages": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "minItems": 0,
              "maxItems": 16,
              "uniqueItems": true
            },
            "habits": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "minItems": 0,
              "maxItems": 16
            }
          },
          "required": ["description", "languages", "habits"],
          "additionalProperties": false
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "goalId": {
                "$ref": "urn:ifsoul:protocol:0.4.0:common#/$defs/id"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "priority": {
                "$ref": "urn:ifsoul:protocol:0.4.0:common#/$defs/priority"
              },
              "status": {
                "enum": ["desired", "active", "paused", "complete"]
              }
            },
            "required": ["goalId", "description", "priority", "status"],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 32
        },
        "authoredBiography": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            },
            "fictional": {
              "const": true
            }
          },
          "required": ["text", "fictional"],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "description",
        "traits",
        "preferences",
        "speechStyle",
        "goals",
        "authoredBiography"
      ],
      "additionalProperties": false
    }
  }
}
