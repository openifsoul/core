{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ifsoul:protocol:0.4.0:environment",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "0.4.0"
    },
    "kind": {
      "const": "environment-profile"
    },
    "binding": {
      "$ref": "urn:ifsoul:protocol:0.4.0:common#/$defs/binding"
    },
    "hostId": {
      "$ref": "urn:ifsoul:protocol:0.4.0:common#/$defs/id"
    },
    "revision": {
      "$ref": "urn:ifsoul:protocol:0.4.0:common#/$defs/id"
    },
    "medium": {
      "enum": ["game", "chat"]
    },
    "embodiment": {
      "type": "object",
      "properties": {
        "form": {
          "$ref": "urn:ifsoul:protocol:0.4.0:common#/$defs/id"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "modalities": {
          "type": "array",
          "items": {
            "enum": ["speech", "text", "vocalization", "gesture", "status"]
          },
          "minItems": 0,
          "maxItems": 5,
          "uniqueItems": true
        }
      },
      "required": ["form", "description", "modalities"],
      "additionalProperties": false
    },
    "participantLinks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claimId": {
            "$ref": "urn:ifsoul:protocol:0.4.0:common#/$defs/id"
          },
          "participantId": {
            "$ref": "urn:ifsoul:protocol:0.4.0:common#/$defs/id"
          },
          "environmentSubjectId": {
            "$ref": "urn:ifsoul:protocol:0.4.0:common#/$defs/id"
          },
          "issuerId": {
            "$ref": "urn:ifsoul:protocol:0.4.0:common#/$defs/id"
          }
        },
        "required": [
          "claimId",
          "participantId",
          "environmentSubjectId",
          "issuerId"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 64
    },
    "planning": {
      "type": "object",
      "properties": {
        "cadence": {
          "enum": ["host-requested", "daily", "event-driven"]
        },
        "maxTasks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      },
      "required": ["cadence", "maxTasks"],
      "additionalProperties": false
    },
    "communication": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": ["host-requested", "live-channel"]
        },
        "availability": {
          "enum": ["on-demand", "persistent"]
        },
        "allowUnrequestedMessages": {
          "type": "boolean"
        },
        "channelIds": {
          "type": "array",
          "items": {
            "$ref": "urn:ifsoul:protocol:0.4.0:common#/$defs/id"
          },
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true
        }
      },
      "required": [
        "mode",
        "availability",
        "allowUnrequestedMessages",
        "channelIds"
      ],
      "additionalProperties": false
    },
    "hostIntents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "intentId": {
            "$ref": "urn:ifsoul:protocol:0.4.0:common#/$defs/id"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "$ref": "urn:ifsoul:protocol:0.4.0:common#/$defs/id"
                },
                "type": {
                  "enum": ["entity-ref", "choice", "quantity", "boolean"]
                },
                "required": {
                  "type": "boolean"
                },
                "choices": {
                  "type": "array",
                  "items": {
                    "$ref": "urn:ifsoul:protocol:0.4.0:common#/$defs/id"
                  },
                  "minItems": 1,
                  "maxItems": 32,
                  "uniqueItems": true
                },
                "unit": {
                  "$ref": "urn:ifsoul:protocol:0.4.0:common#/$defs/id"
                },
                "minimum": {
                  "type": "number"
                },
                "maximum": {
                  "type": "number"
                }
              },
              "required": ["name", "type", "required"],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 16
          },
          "cancellable": {
            "type": "boolean"
          }
        },
        "required": ["intentId", "description", "parameters", "cancellable"],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 32
    },
    "worldTime": {
      "$ref": "urn:ifsoul:protocol:0.4.0:common#/$defs/worldTime"
    },
    "extensions": {
      "$ref": "urn:ifsoul:protocol:0.4.0:common#/$defs/extensions"
    },
    "requiredExtensions": {
      "type": "array",
      "items": {
        "$ref": "urn:ifsoul:protocol:0.4.0:common#/$defs/extensionName"
      },
      "minItems": 0,
      "maxItems": 16,
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "binding",
    "hostId",
    "revision",
    "medium",
    "embodiment",
    "participantLinks",
    "planning",
    "communication",
    "hostIntents"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "communication": {
            "type": "object",
            "properties": {
              "mode": {
                "const": "host-requested"
              }
            },
            "required": ["mode"]
          }
        },
        "required": ["communication"]
      },
      "then": {
        "properties": {
          "communication": {
            "type": "object",
            "properties": {
              "allowUnrequestedMessages": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
}
