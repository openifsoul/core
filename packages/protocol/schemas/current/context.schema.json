{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ifsoul:protocol:0.3.0:context",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "0.3.0"
    },
    "kind": {
      "const": "context-report"
    },
    "reportId": {
      "$ref": "urn:ifsoul:protocol:0.3.0:common#/$defs/id"
    },
    "contextRevision": {
      "$ref": "urn:ifsoul:protocol:0.3.0:common#/$defs/id"
    },
    "environmentRevision": {
      "$ref": "urn:ifsoul:protocol:0.3.0:common#/$defs/id"
    },
    "correlationId": {
      "$ref": "urn:ifsoul:protocol:0.3.0:common#/$defs/id"
    },
    "binding": {
      "$ref": "urn:ifsoul:protocol:0.3.0:common#/$defs/binding"
    },
    "recordedAt": {
      "$ref": "urn:ifsoul:protocol:0.3.0:common#/$defs/utc"
    },
    "period": {
      "$ref": "urn:ifsoul:protocol:0.3.0:common#/$defs/period"
    },
    "observedState": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "properties": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "subjectId": {
                "$ref": "urn:ifsoul:protocol:0.3.0:common#/$defs/id"
              },
              "propertyId": {
                "$ref": "urn:ifsoul:protocol:0.3.0:common#/$defs/id"
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 500
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            },
            "required": ["subjectId", "propertyId", "value"],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 128
        }
      },
      "required": ["summary", "properties"],
      "additionalProperties": false
    },
    "priorNeeds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "needId": {
            "$ref": "urn:ifsoul:protocol:0.3.0:common#/$defs/id"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "priority": {
            "$ref": "urn:ifsoul:protocol:0.3.0:common#/$defs/priority"
          },
          "status": {
            "enum": ["current", "resolved", "unknown"]
          }
        },
        "required": ["needId", "description", "priority", "status"],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 32
    },
    "priorPlans": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "planId": {
            "$ref": "urn:ifsoul:protocol:0.3.0:common#/$defs/id"
          },
          "taskStates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "taskId": {
                  "$ref": "urn:ifsoul:protocol:0.3.0:common#/$defs/id"
                },
                "status": {
                  "$ref": "urn:ifsoul:protocol:0.3.0:common#/$defs/taskStatus"
                }
              },
              "required": ["taskId", "status"],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 16
          }
        },
        "required": ["planId", "taskStates"],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 16
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "changeId": {
            "$ref": "urn:ifsoul:protocol:0.3.0:common#/$defs/id"
          },
          "kind": {
            "enum": ["change", "event"]
          },
          "recordedAt": {
            "$ref": "urn:ifsoul:protocol:0.3.0:common#/$defs/utc"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "worldTime": {
            "$ref": "urn:ifsoul:protocol:0.3.0:common#/$defs/worldTime"
          }
        },
        "required": ["changeId", "kind", "recordedAt", "summary"],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 64
    },
    "planningRequest": {
      "type": "object",
      "properties": {
        "requestId": {
          "$ref": "urn:ifsoul:protocol:0.3.0:common#/$defs/id"
        },
        "cadence": {
          "enum": ["host-requested", "daily", "event-driven"]
        },
        "horizon": {
          "$ref": "urn:ifsoul:protocol:0.3.0:common#/$defs/period"
        },
        "maxTasks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "allowedIntentIds": {
          "type": "array",
          "items": {
            "$ref": "urn:ifsoul:protocol:0.3.0:common#/$defs/id"
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        }
      },
      "required": [
        "requestId",
        "cadence",
        "horizon",
        "maxTasks",
        "allowedIntentIds"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "$ref": "urn:ifsoul:protocol:0.3.0:common#/$defs/extensions"
    },
    "requiredExtensions": {
      "type": "array",
      "items": {
        "$ref": "urn:ifsoul:protocol:0.3.0:common#/$defs/extensionName"
      },
      "minItems": 0,
      "maxItems": 16,
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "reportId",
    "contextRevision",
    "environmentRevision",
    "correlationId",
    "binding",
    "recordedAt",
    "period",
    "observedState",
    "priorNeeds",
    "priorPlans",
    "changes"
  ],
  "additionalProperties": false
}
