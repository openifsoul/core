{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ifsoul:protocol:0.3.0:archive",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "0.3.0"
    },
    "kind": {
      "const": "archive-manifest"
    },
    "archiveVersion": {
      "const": "0.3.0"
    },
    "archiveId": {
      "$ref": "urn:ifsoul:protocol:0.3.0:common#/$defs/id"
    },
    "characterId": {
      "$ref": "urn:ifsoul:protocol:0.3.0:common#/$defs/id"
    },
    "createdAt": {
      "$ref": "urn:ifsoul:protocol:0.3.0:common#/$defs/utc"
    },
    "transferIntent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "resume"
            },
            "expectedCharacterId": {
              "$ref": "urn:ifsoul:protocol:0.3.0:common#/$defs/id"
            }
          },
          "required": ["mode", "expectedCharacterId"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "fork"
            },
            "newCharacterId": {
              "$ref": "urn:ifsoul:protocol:0.3.0:common#/$defs/id"
            },
            "newParticipantId": {
              "$ref": "urn:ifsoul:protocol:0.3.0:common#/$defs/id"
            }
          },
          "required": ["mode", "newCharacterId", "newParticipantId"],
          "additionalProperties": false
        }
      ]
    },
    "schemaInventory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schemaId": {
            "type": "string",
            "pattern": "^urn:ifsoul:protocol:0[.]3[.]0:(character|memory)$"
          },
          "schemaVersion": {
            "const": "0.3.0"
          }
        },
        "required": ["schemaId", "schemaVersion"],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
          },
          "role": {
            "enum": ["character-template", "character-instance", "memory"]
          },
          "schemaId": {
            "type": "string",
            "pattern": "^urn:ifsoul:protocol:0[.]3[.]0:(character|memory)$"
          },
          "recordCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "path",
          "role",
          "schemaId",
          "recordCount",
          "sha256",
          "sizeBytes"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "filter": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": ["complete-authorized", "filtered"]
        },
        "omittedCategories": {
          "type": "array",
          "items": {
            "enum": [
              "profile",
              "events",
              "working-context",
              "episodes",
              "facts",
              "relationships",
              "intent-checkpoints",
              "extensions"
            ]
          },
          "minItems": 0,
          "maxItems": 8,
          "uniqueItems": true
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 0,
          "maxItems": 16
        },
        "externalReferences": {
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "omittedCategories",
        "reasons",
        "externalReferences"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "$ref": "urn:ifsoul:protocol:0.3.0:common#/$defs/provenance"
    },
    "portableCheckpointIds": {
      "type": "array",
      "items": {
        "$ref": "urn:ifsoul:protocol:0.3.0:common#/$defs/id"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "extensions": {
      "$ref": "urn:ifsoul:protocol:0.3.0:common#/$defs/extensions"
    },
    "requiredExtensions": {
      "type": "array",
      "items": {
        "$ref": "urn:ifsoul:protocol:0.3.0:common#/$defs/extensionName"
      },
      "minItems": 0,
      "maxItems": 16,
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "archiveVersion",
    "archiveId",
    "characterId",
    "createdAt",
    "transferIntent",
    "schemaInventory",
    "files",
    "filter",
    "provenance",
    "portableCheckpointIds"
  ],
  "additionalProperties": false
}
