{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ifsoul:protocol:draft-0.1.0:character-instance",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "draft-0.1.0"
    },
    "kind": {
      "const": "character-instance"
    },
    "characterId": {
      "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/id"
    },
    "createdAt": {
      "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/utcTimestamp"
    },
    "template": {
      "type": "object",
      "properties": {
        "templateId": {
          "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["templateId", "revision"],
      "additionalProperties": false
    },
    "profile": {
      "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/profile"
    },
    "historyEventIds": {
      "type": "array",
      "items": {
        "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/id"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "relationshipMemoryIds": {
      "type": "array",
      "items": {
        "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/id"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "extensions": {
      "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/extensions"
    },
    "requiredExtensions": {
      "type": "array",
      "items": {
        "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/extensionName"
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "characterId",
    "createdAt",
    "profile",
    "historyEventIds",
    "relationshipMemoryIds"
  ],
  "additionalProperties": false
}
