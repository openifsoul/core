{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ifsoul:protocol:draft-0.1.0:character-template",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "draft-0.1.0"
    },
    "kind": {
      "const": "character-template"
    },
    "templateId": {
      "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "profile": {
      "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/profile"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["authors", "license"],
      "additionalProperties": false
    },
    "extensions": {
      "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/extensions"
    },
    "requiredExtensions": {
      "type": "array",
      "items": {
        "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/extensionName"
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "templateId",
    "revision",
    "profile",
    "provenance"
  ],
  "additionalProperties": false
}
