{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ifsoul:protocol:draft-0.2.0:planning",
  "oneOf": [
    {
      "$ref": "#/$defs/proposal"
    },
    {
      "$ref": "#/$defs/decision"
    },
    {
      "$ref": "#/$defs/report"
    },
    {
      "$ref": "#/$defs/cancelRequest"
    },
    {
      "$ref": "#/$defs/cancelResult"
    }
  ],
  "$defs": {
    "proposal": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "draft-0.2.0"
        },
        "kind": {
          "const": "plan-proposal"
        },
        "binding": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/binding"
        },
        "correlationId": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "planId": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "requestId": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "contextReportId": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "contextRevision": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "environmentRevision": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "createdAt": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/utc"
        },
        "expiresAt": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/utc"
        },
        "horizon": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/period"
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "taskId": {
                "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
              },
              "intentId": {
                "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
              },
              "arguments": {
                "type": "object",
                "maxProperties": 16,
                "propertyNames": {
                  "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
                },
                "additionalProperties": {
                  "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/argument"
                }
              },
              "priority": {
                "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/priority"
              },
              "dependsOnTaskIds": {
                "type": "array",
                "items": {
                  "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
                },
                "minItems": 0,
                "maxItems": 16,
                "uniqueItems": true
              },
              "explanation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": [
              "taskId",
              "intentId",
              "arguments",
              "priority",
              "dependsOnTaskIds"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 16
        },
        "extensions": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/extensions"
        },
        "requiredExtensions": {
          "type": "array",
          "items": {
            "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/extensionName"
          },
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "binding",
        "correlationId",
        "planId",
        "requestId",
        "contextReportId",
        "contextRevision",
        "environmentRevision",
        "createdAt",
        "expiresAt",
        "horizon",
        "tasks"
      ],
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "draft-0.2.0"
        },
        "kind": {
          "const": "plan-decision"
        },
        "binding": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/binding"
        },
        "correlationId": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "planId": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "decisionId": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "requestId": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "contextRevision": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "recordedAt": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/utc"
        },
        "status": {
          "enum": ["accepted", "partially-accepted", "rejected"]
        },
        "taskDecisions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "taskId": {
                "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
              },
              "decision": {
                "enum": ["accepted", "rejected"]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": ["taskId", "decision"],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 16
        },
        "extensions": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/extensions"
        },
        "requiredExtensions": {
          "type": "array",
          "items": {
            "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/extensionName"
          },
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "binding",
        "correlationId",
        "planId",
        "decisionId",
        "requestId",
        "contextRevision",
        "recordedAt",
        "status",
        "taskDecisions"
      ],
      "additionalProperties": false
    },
    "report": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "draft-0.2.0"
        },
        "kind": {
          "const": "task-report"
        },
        "binding": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/binding"
        },
        "correlationId": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "planId": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "reportId": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "taskId": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "contextRevision": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "recordedAt": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/utc"
        },
        "status": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/taskStatus"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "observedEffects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 0,
          "maxItems": 16
        },
        "nextContextReportId": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "extensions": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/extensions"
        },
        "requiredExtensions": {
          "type": "array",
          "items": {
            "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/extensionName"
          },
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "binding",
        "correlationId",
        "planId",
        "reportId",
        "taskId",
        "contextRevision",
        "recordedAt",
        "status",
        "summary",
        "observedEffects"
      ],
      "additionalProperties": false
    },
    "cancelRequest": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "draft-0.2.0"
        },
        "kind": {
          "const": "plan-cancel-request"
        },
        "binding": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/binding"
        },
        "correlationId": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "planId": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "cancellationId": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "taskIds": {
          "type": "array",
          "items": {
            "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "requestedAt": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/utc"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "extensions": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/extensions"
        },
        "requiredExtensions": {
          "type": "array",
          "items": {
            "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/extensionName"
          },
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "binding",
        "correlationId",
        "planId",
        "cancellationId",
        "taskIds",
        "requestedAt",
        "reason"
      ],
      "additionalProperties": false
    },
    "cancelResult": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "draft-0.2.0"
        },
        "kind": {
          "const": "plan-cancel-result"
        },
        "binding": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/binding"
        },
        "correlationId": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "planId": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "cancellationId": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "recordedAt": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/utc"
        },
        "taskResults": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "taskId": {
                "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
              },
              "status": {
                "enum": ["cancelled", "already-finished", "rejected", "unknown"]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": ["taskId", "status"],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 16
        },
        "extensions": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/extensions"
        },
        "requiredExtensions": {
          "type": "array",
          "items": {
            "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/extensionName"
          },
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "binding",
        "correlationId",
        "planId",
        "cancellationId",
        "recordedAt",
        "taskResults"
      ],
      "additionalProperties": false
    }
  }
}
