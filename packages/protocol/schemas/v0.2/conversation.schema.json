{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ifsoul:protocol:draft-0.2.0:conversation",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/delivery"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "draft-0.2.0"
        },
        "kind": {
          "const": "conversation-request"
        },
        "binding": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/binding"
        },
        "requestId": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "correlationId": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "channelId": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "speakerParticipantId": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "recipientParticipantIds": {
          "type": "array",
          "items": {
            "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        },
        "environmentRevision": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "contextRevision": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "mode": {
          "enum": ["host-requested", "live-channel"]
        },
        "trigger": {
          "enum": ["host-request", "incoming-message", "presence-event"]
        },
        "requestedModality": {
          "enum": ["text", "speech", "vocalization", "gesture", "status"]
        },
        "receivedAt": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/utc"
        },
        "deadlineAt": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/utc"
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "messageId": {
                "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
              },
              "participantId": {
                "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
              },
              "recordedAt": {
                "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/utc"
              },
              "modality": {
                "enum": ["text", "speech", "vocalization", "gesture", "status"]
              },
              "content": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "messageId",
              "participantId",
              "recordedAt",
              "modality",
              "content"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 50
        },
        "extensions": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/extensions"
        },
        "requiredExtensions": {
          "type": "array",
          "items": {
            "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/extensionName"
          },
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "binding",
        "requestId",
        "correlationId",
        "channelId",
        "speakerParticipantId",
        "recipientParticipantIds",
        "environmentRevision",
        "contextRevision",
        "mode",
        "trigger",
        "requestedModality",
        "receivedAt",
        "deadlineAt",
        "messages"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "host-requested"
              }
            },
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "trigger": {
                "const": "host-request"
              }
            }
          }
        }
      ]
    },
    "response": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "draft-0.2.0"
        },
        "kind": {
          "const": "conversation-response"
        },
        "binding": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/binding"
        },
        "requestId": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "correlationId": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "channelId": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "speakerParticipantId": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "recipientParticipantIds": {
          "type": "array",
          "items": {
            "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        },
        "responseId": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "createdAt": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/utc"
        },
        "expiresAt": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/utc"
        },
        "output": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "utterance"
                },
                "modality": {
                  "enum": [
                    "text",
                    "speech",
                    "vocalization",
                    "gesture",
                    "status"
                  ]
                },
                "content": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              },
              "required": ["type", "modality", "content"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "no-output"
                },
                "reason": {
                  "enum": [
                    "unsupported-modality",
                    "no-response-needed",
                    "policy",
                    "deadline-exceeded"
                  ]
                }
              },
              "required": ["type", "reason"],
              "additionalProperties": false
            }
          ]
        },
        "extensions": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/extensions"
        },
        "requiredExtensions": {
          "type": "array",
          "items": {
            "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/extensionName"
          },
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "binding",
        "requestId",
        "correlationId",
        "channelId",
        "speakerParticipantId",
        "recipientParticipantIds",
        "responseId",
        "createdAt",
        "expiresAt",
        "output"
      ],
      "additionalProperties": false
    },
    "delivery": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "draft-0.2.0"
        },
        "kind": {
          "const": "conversation-delivery"
        },
        "binding": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/binding"
        },
        "requestId": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "responseId": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "correlationId": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "channelId": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "deliveryId": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/id"
        },
        "recordedAt": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/utc"
        },
        "status": {
          "enum": ["accepted", "delivered", "rejected", "unknown"]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "extensions": {
          "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/extensions"
        },
        "requiredExtensions": {
          "type": "array",
          "items": {
            "$ref": "urn:ifsoul:protocol:draft-0.2.0:common#/$defs/extensionName"
          },
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "binding",
        "requestId",
        "responseId",
        "correlationId",
        "channelId",
        "deliveryId",
        "recordedAt",
        "status"
      ],
      "additionalProperties": false
    }
  }
}
