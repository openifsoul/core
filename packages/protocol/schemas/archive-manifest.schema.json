{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ifsoul:protocol:draft-0.1.0:archive-manifest",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "draft-0.1.0"
    },
    "kind": {
      "const": "archive-manifest"
    },
    "archiveVersion": {
      "const": "draft-0.1.0"
    },
    "archiveId": {
      "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/id"
    },
    "createdAt": {
      "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/utcTimestamp"
    },
    "schemaVersions": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "draft-0.1.0"
        }
      },
      "required": ["protocol"],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
          },
          "role": {
            "enum": ["template", "instance", "events", "derived", "extension"]
          },
          "schemaId": {
            "type": "string",
            "pattern": "^urn:ifsoul:protocol:draft-0\\.1\\.0:[a-z-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["path", "role", "schemaId", "sha256", "sizeBytes"],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "filter": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": ["private-backup", "filtered"]
        },
        "omittedCategories": {
          "type": "array",
          "items": {
            "enum": [
              "profile",
              "events",
              "derived",
              "relationships",
              "extensions"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "externalReferences": {
          "enum": ["none", "present"]
        }
      },
      "required": [
        "mode",
        "omittedCategories",
        "reasons",
        "externalReferences"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/extensions"
    },
    "requiredExtensions": {
      "type": "array",
      "items": {
        "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/extensionName"
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "archiveVersion",
    "archiveId",
    "createdAt",
    "schemaVersions",
    "files",
    "filter"
  ],
  "additionalProperties": false
}
