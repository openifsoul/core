{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ifsoul:protocol:draft-0.1.0:action-result",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "draft-0.1.0"
    },
    "kind": {
      "const": "action-result"
    },
    "resultId": {
      "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/id"
    },
    "actionId": {
      "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/id"
    },
    "adapterId": {
      "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/id"
    },
    "worldId": {
      "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/id"
    },
    "sessionId": {
      "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/id"
    },
    "actorId": {
      "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/id"
    },
    "recordedAt": {
      "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/utcTimestamp"
    },
    "worldTime": {
      "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/worldTime"
    },
    "status": {
      "enum": ["success", "rejected", "failed", "unknown"]
    },
    "execution": {
      "enum": ["not-started", "completed", "partial", "unknown"]
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "urn:ifsoul:protocol:draft-0.1.0:world-event"
      },
      "minItems": 0
    },
    "error": {
      "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/error"
    },
    "worldRevision": {
      "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/id"
    },
    "extensions": {
      "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/extensions"
    },
    "requiredExtensions": {
      "type": "array",
      "items": {
        "$ref": "urn:ifsoul:protocol:draft-0.1.0:common#/$defs/extensionName"
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "resultId",
    "actionId",
    "adapterId",
    "worldId",
    "sessionId",
    "actorId",
    "recordedAt",
    "worldTime",
    "status",
    "execution",
    "events"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "success"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "execution": {
            "const": "completed"
          },
          "error": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "rejected"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "execution": {
            "const": "not-started"
          },
          "events": {
            "maxItems": 0,
            "type": "array"
          }
        },
        "required": ["error"]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "execution": {
            "enum": ["not-started", "partial"]
          }
        },
        "required": ["error"]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unknown"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "execution": {
            "const": "unknown"
          },
          "error": {
            "properties": {
              "retry": {
                "const": "reconcile-first"
              }
            },
            "type": "object"
          }
        },
        "required": ["error"]
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "const": "not-started"
          }
        },
        "required": ["execution"]
      },
      "then": {
        "properties": {
          "events": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    }
  ]
}
