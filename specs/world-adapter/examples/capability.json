        "type": "object",
        "properties": {
          "plantId": {
            "type": "string"
          },
          "amountMl": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": ["plantId", "amountMl"],
        "additionalProperties": false
      },
      "requiredPermissions": [
        {
          "resource": "plant-1",
          "action": "water"
        }
      ],
      "semantics": {
        "preconditions": [
          "The plant is visible and reachable; water remains in the can."
        ],
        "possibleEffects": ["Water is consumed and the plant receives it."]
      },
      "idempotency": "none"
    }
  ]
}
