{
  "schemaVersion": "draft-0.1.0",
  "kind": "capability-set",
  "adapterId": "synthetic-garden",
  "worldId": "garden",
  "sessionId": "session-1",
  "actorId": "actor-mira",
  "capabilityRevision": "capabilities-1",
